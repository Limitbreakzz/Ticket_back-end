    {
      "name": "Departments",
      "description": "API สำหรับเรียกดูและจัดการรายชื่อแผนก",
      "item": [
        {
          "name": "Get All Departments",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    const depts = json.data || json;",
                  "    if (Array.isArray(depts) && depts.length > 0) {",
                  "        const itDept = depts.find(d => d.code === 'IT' || d.name.includes('IT') || d.name.includes('ไอที'));",
                  "        if (itDept) pm.collectionVariables.set('departmentId', itDept.id);",
                  "        else pm.collectionVariables.set('departmentId', depts[0].id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/departments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "departments"
              ]
            }
          }
        }
      ]
