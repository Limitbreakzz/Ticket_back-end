datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
  MANAGER
}

enum TicketStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CANCELLED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketCategory {
  HARDWARE
  SOFTWARE
  NETWORK
  ACCESS
  OTHER
}

enum TransferStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
}

model Department {
  id        String   @id @default(uuid()) @map("dept_id")
  name      String   @unique
  code      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users          User[]
  sourceTickets  Ticket[]         @relation("TicketSourceDepartment")
  targetTickets  Ticket[]         @relation("TicketTargetDepartment")
  transfersFrom  TicketTransfer[] @relation("TransferFromDepartment")
  transfersTo    TicketTransfer[] @relation("TransferToDepartment")

  @@map("Department")
}

model User {
  id           String   @id @default(uuid()) @map("user_id")
  email        String   @unique
  username     String?  @unique
  name         String
  password     String?
  role         Role     @default(USER)
  avatarUrl    String?  @db.LongText @map("avatar_url")
  departmentId String?  @map("dept_id")
  createdAt    DateTime @default(now()) @map("created_at")

  department             Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  ticketsCreated         Ticket[]         @relation("UserTickets")
  ticketsAssigned        Ticket[]         @relation("AgentTickets")
  ticketsReceivedManager Ticket[]         @relation("ReceiverManagerTickets")
  comments               Comment[]
  transfersCreated       TicketTransfer[] @relation("TransferRequestedBy")
  notifications          Notification[]
  attachments            Attachment[]

  @@map("User")
}

model Ticket {
  id                 String         @id @default(uuid()) @map("ticket_id")
  title              String
  description        String         @db.Text
  status             TicketStatus   @default(NEW)
  priority           TicketPriority @default(MEDIUM)
  category           TicketCategory
  subcategory        String?
  slaDueDate         DateTime?      @map("sla_due_date")
  resolvedAt         DateTime?      @map("resolved_at")
  attachmentUrl      String?        @db.LongText @map("attach_url")
  userId             String         @map("user_id")
  agentId            String?        @map("agent_id")
  receiverManagerId  String?        @map("manager_id")
  sourceDepartmentId String?        @map("src_dept_id")
  targetDepartmentId String?        @map("tgt_dept_id")

  user            User        @relation("UserTickets", fields: [userId], references: [id])
  agent           User?       @relation("AgentTickets", fields: [agentId], references: [id])
  receiverManager User?       @relation("ReceiverManagerTickets", fields: [receiverManagerId], references: [id], onDelete: SetNull)

  sourceDepartment Department? @relation("TicketSourceDepartment", fields: [sourceDepartmentId], references: [id], onDelete: SetNull)
  targetDepartment Department? @relation("TicketTargetDepartment", fields: [targetDepartmentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  comments    Comment[]
  transfers   TicketTransfer[]
  attachments Attachment[]

  @@index([status])
  @@index([priority])
  @@index([userId])
  @@index([agentId])
  @@index([createdAt])
  @@index([sourceDepartmentId])
  @@index([targetDepartmentId])
  @@index([receiverManagerId])
  @@map("Ticket")
}

model TicketTransfer {
  id               String         @id @default(uuid()) @map("transfer_id")
  ticketId         String         @map("ticket_id")
  fromDepartmentId String?        @map("from_dept_id")
  toDepartmentId   String?        @map("to_dept_id")
  requestedById    String         @map("req_by_id")
  status           TransferStatus @default(PENDING)
  note             String?        @db.Text
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  ticket         Ticket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromDepartment Department? @relation("TransferFromDepartment", fields: [fromDepartmentId], references: [id], onDelete: SetNull)
  toDepartment   Department? @relation("TransferToDepartment", fields: [toDepartmentId], references: [id], onDelete: SetNull)
  requestedBy    User        @relation("TransferRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)

  @@map("TicketTransfer")
}

model Comment {
  id            String    @id @default(uuid()) @map("comment_id")
  ticketId      String    @map("ticket_id")
  userId        String    @map("user_id")
  message       String    @db.Text
  attachmentUrl String?   @db.LongText @map("attach_url")
  isEdited      Boolean   @default(false) @map("is_edited")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime? @updatedAt @map("updated_at")
  readAt        DateTime? @map("read_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@map("Comment")
}

model WebhookConfig {
  id                  String   @id @default(uuid()) @map("webhook_id")
  name                String
  url                 String
  targetDepartment    String   @default("all") @map("target_dept")
  allowPrivateTickets Boolean  @default(false) @map("allow_private")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("WebhookConfig")
}

model Notification {
  id        String   @id @default(uuid()) @map("notify_id")
  userId    String   @map("user_id")
  title     String
  message   String   @db.Text
  isRead    Boolean  @default(false) @map("is_read")
  link      String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("Notification")
}

model Attachment {
  id        String   @id @default(uuid()) @map("attach_id")
  fileName  String   @map("file_name")
  fileType  String   @map("file_type")
  fileUrl   String   @db.LongText @map("file_url")
  userId    String?  @map("user_id")
  ticketId  String?  @map("ticket_id")
  createdAt DateTime @default(now()) @map("created_at")

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  ticket Ticket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("Attchment")
}
