datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
  MANAGER
}

enum TicketStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CANCELLED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketCategory {
  HARDWARE
  SOFTWARE
  NETWORK
  ACCESS
  OTHER
}

enum TransferStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
}

model Department {
  dept_id    String   @id @default(uuid())
  name       String   @unique
  code       String   @unique
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  users          User[]
  sourceTickets  Ticket[]         @relation("TicketSourceDepartment")
  targetTickets  Ticket[]         @relation("TicketTargetDepartment")
  transfersFrom  TicketTransfer[] @relation("TransferFromDepartment")
  transfersTo    TicketTransfer[] @relation("TransferToDepartment")
}

model User {
  user_id    String   @id @default(uuid())
  email      String   @unique
  username   String?  @unique
  name       String
  password   String?
  role       Role     @default(USER)
  avatar_url String?  @db.LongText
  dept_id    String?
  created_at DateTime @default(now())

  department             Department?      @relation(fields: [dept_id], references: [dept_id], onDelete: SetNull)
  ticketsCreated         Ticket[]         @relation("UserTickets")
  ticketsAssigned        Ticket[]         @relation("AgentTickets")
  ticketsReceivedManager Ticket[]         @relation("ReceiverManagerTickets")
  comments               Comment[]
  transfersCreated       TicketTransfer[] @relation("TransferRequestedBy")
  notifications          Notification[]
  attachments            Attachment[]
}

model Ticket {
  ticket_id    String         @id @default(uuid())
  title        String
  description  String         @db.Text
  status       TicketStatus   @default(NEW)
  priority     TicketPriority @default(MEDIUM)
  category     TicketCategory
  subcategory  String?
  sla_due_date DateTime?
  resolved_at  DateTime?
  attach_url   String?        @db.LongText
  user_id      String
  agent_id     String?
  manager_id   String?
  src_dept_id  String?
  tgt_dept_id  String?
  created_at   DateTime       @default(now())
  updated_at   DateTime       @updatedAt

  user            User        @relation("UserTickets", fields: [user_id], references: [user_id])
  agent           User?       @relation("AgentTickets", fields: [agent_id], references: [user_id])
  receiverManager User?       @relation("ReceiverManagerTickets", fields: [manager_id], references: [user_id], onDelete: SetNull)

  sourceDepartment Department? @relation("TicketSourceDepartment", fields: [src_dept_id], references: [dept_id], onDelete: SetNull)
  targetDepartment Department? @relation("TicketTargetDepartment", fields: [tgt_dept_id], references: [dept_id], onDelete: SetNull)

  comments    Comment[]
  transfers   TicketTransfer[]
  attachments Attachment[]

  @@index([status])
  @@index([priority])
  @@index([user_id])
  @@index([agent_id])
  @@index([created_at])
  @@index([src_dept_id])
  @@index([tgt_dept_id])
  @@index([manager_id])
}

model TicketTransfer {
  transfer_id   String         @id @default(uuid())
  ticket_id     String
  from_dept_id  String?
  to_dept_id    String?
  req_by_id     String
  status        TransferStatus @default(PENDING)
  note          String?        @db.Text
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt

  ticket         Ticket      @relation(fields: [ticket_id], references: [ticket_id], onDelete: Cascade)
  fromDepartment Department? @relation("TransferFromDepartment", fields: [from_dept_id], references: [dept_id], onDelete: SetNull)
  toDepartment   Department? @relation("TransferToDepartment", fields: [to_dept_id], references: [dept_id], onDelete: SetNull)
  requestedBy    User        @relation("TransferRequestedBy", fields: [req_by_id], references: [user_id], onDelete: Cascade)
}

model Comment {
  comment_id String    @id @default(uuid())
  ticket_id  String
  user_id    String
  message    String    @db.Text
  attach_url String?   @db.LongText
  is_edited  Boolean   @default(false)
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  read_at    DateTime?

  ticket Ticket @relation(fields: [ticket_id], references: [ticket_id], onDelete: Cascade)
  user   User   @relation(fields: [user_id], references: [user_id])
}

model WebhookConfig {
  webhook_id    String   @id @default(uuid())
  name          String
  url           String
  target_dept   String   @default("all")
  allow_private Boolean  @default(false)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now()) @updatedAt
}

model Notification {
  notify_id  String   @id @default(uuid())
  user_id    String
  title      String
  message    String   @db.Text
  is_read    Boolean  @default(false)
  link       String?
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
}

model Attachment {
  attach_id  String   @id @default(uuid())
  file_name  String
  file_type  String
  file_url   String   @db.LongText
  user_id    String?
  ticket_id  String?
  created_at DateTime @default(now())

  user   User?   @relation(fields: [user_id], references: [user_id], onDelete: SetNull)
  ticket Ticket? @relation(fields: [ticket_id], references: [ticket_id], onDelete: Cascade)
}
